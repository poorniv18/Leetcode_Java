import java.util.Scanner;
interface Discount{
    double applyDiscount(double price);
}
class SeasonalDiscount implements Discount{
    public double applyDiscount(double price){
        return price*0.90;
    }
}
class MemberDiscount implements Discount{
    public double applyDiscount(double price){
        return price*0.80;
    }
}
class ClearanceDiscount implements Discount{
    public double applyDiscount(double price){
        return price*0.50;
    }
}
    
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        String type=sc.nextLine().trim();
        double price=sc.nextDouble();
        if(price<=0){
            System.out.println("Invalid input");
            sc.close();
            return;
        }
        Discount discount=null;
        switch(type){
            case "Seasonal":
            discount=new SeasonalDiscount();
            break;
            case "Member":
            discount=new MemberDiscount();
            break;
            case "Clearance":
            discount=new ClearanceDiscount();
            break;
            default:
            System.out.println("Invalid input");
            sc.close();
            return;
        }
        double finalPrice=discount.applyDiscount(price);
        System.out.printf("%.2f%n",finalPrice);
        sc.close();
    }
}
        
