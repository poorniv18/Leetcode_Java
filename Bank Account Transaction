import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int balance=sc.nextInt();
        int N=sc.nextInt();
        balance+=N;
        System.out.println(balance);
        balance-=N;
        System.out.println(balance);
        balance*=N;
        System.out.println(balance);
        balance/=N;
        System.out.println(balance);
        balance%=N;
        System.out.println(balance);


     
    }
}
